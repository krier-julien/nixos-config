  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@gitlab.fancy.org.uk:samuel/nxapi.git"
  },
  "homepage": "https://gitlab.fancy.org.uk/samuel/nxapi",
  "bugs": "https://github.com/samuelthomas2774/nxapi/issues",
  "files": [
    "dist",
