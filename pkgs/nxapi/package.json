    "!dist/bundle",
    "resources/cli",
    "resources/common",
    "bin"
  ],
  "exports": {
    ".": "./dist/exports/index.js",
    "./coral": "./dist/exports/coral.js",
    "./moon": "./dist/exports/moon.js",
    "./splatnet2": "./dist/exports/splatnet2.js",
    "./nooklink": "./dist/exports/nooklink.js",
    "./splatnet3": "./dist/exports/splatnet3.js"
  },
  "bin": {
    "nxapi": "bin/nxapi.js"
  },
  "dependencies": {
    "body-parser": "^1.20.1",
    "cli-table": "^0.3.11",
    "debug": "^4.3.4",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.0.3",
    "dotenv-expand": "^9.0.0",
    "env-paths": "^3.0.0",
    "eventsource": "^2.0.2",
    "express": "^4.18.2",
    "mkdirp": "^1.0.4",
    "node-fetch": "^3.3.0",
    "node-notifier": "^10.0.1",
    "node-persist": "^3.1.0",
    "read": "^1.0.7",
    "splatnet3-types": "^0.2.20230227204004",
    "supports-color": "^8.1.1",
    "tslib": "^2.4.1",
    "uuid": "^8.3.2",
    "yargs": "^17.6.2"
  },
  "build": {
    "appId": "uk.org.fancy.nxapi.app",
    "productName": "Nintendo Switch Online",
    "copyright": "Copyright © 2022 Samuel Elliott",
    "npmRebuild": false,
    "files": [
      "dist/app/bundle",
      "dist/bundle",
      "!dist/app/package",
      "!**/node_modules/**/*",
      "resources/app",
      "resources/common"
    ],
    "asar": false,
    "extraMetadata": {
      "name": "nxapi-app",
      "main": "dist/bundle/app-entry.cjs",
      "dependencies": {},
      "optionalDependencies": {},
      "devDependencies": {}
    },
    "directories": {
      "output": "dist/app/package"
    },
    "protocols": [
      {
        "name": "Nintendo Switch Online",
        "schemes": [
          "com.nintendo.znca"
        ]
      },
      {
        "name": "Nintendo Account authentication for Nintendo Switch Online",
        "schemes": [
          "npf71b963c1b7b6d119"
        ]
      },
      {
        "name": "Nintendo Account authentication for Nintendo Switch Parental Controls",
        "schemes": [
          "npf54789befb391a838"
        ]
      }
    ],
    "mac": {
      "identity": null
    }
  },
  "__nxapi_release": "v1.6.1",
  "__nxapi_git": {
    "revision": "6da54cde098bba3da3b6a141fc044c4d165c8aea",
    "branch": null,
    "changed_files": []
  }
}
